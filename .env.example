# Server
PORT=3000
HOST=0.0.0.0

# Redis (local dev uses Docker on 6381, prod uses Upstash URL)
REDIS_URL=redis://localhost:6381

# MaxMind GeoLite2 — required for IP geo/ASN lookups
# Sign up free: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# AbuseIPDB — optional enrichment, 1000 free checks/day
# Sign up: https://www.abuseipdb.com/register
ABUSEIPDB_KEY=
