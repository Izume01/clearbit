{
  "name": "privi-api",
  "version": "1.0.0",
  "description": "Anti-Fraud Risk Assessment API — serverless-first, flag-based risk engine",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "refresh-data": "node scripts/refresh-all.js",
    "refresh-tor": "node scripts/refresh-tor.js",
    "refresh-cloud": "node scripts/refresh-cloud-ips.js",
    "refresh-emails": "node scripts/refresh-email-lists.js",
    "refresh-ipsum": "node scripts/refresh-ipsum.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "ip-range-check": "^0.2.0",
    "maxmind": "^4.3.23",
    "netmask": "^2.1.1",
    "node-cron": "^3.0.3",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "vitest": "^3.0.4"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  }
